{
  "name": "codex-learning-navigator",
  "displayName": "Codex Learning Navigator",
  "description": "A lane-table navigator with exact temporary forks for official Codex task branches.",
  "version": "0.8.1",
  "publisher": "local-learning-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WuZheng27/learning-lanes-vscode.git"
  },
  "homepage": "https://github.com/WuZheng27/learning-lanes-vscode#readme",
  "bugs": {
    "url": "https://github.com/WuZheng27/learning-lanes-vscode/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "learning",
    "conversation",
    "branch"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:learningNavigator.open",
    "onCommand:learningNavigator.selectRoot",
    "onCommand:learningNavigator.sync",
    "onCommand:learningNavigator.deleteSubtree",
    "onCommand:learningNavigator.undo",
    "onCommand:learningNavigator.redo"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "learningNavigator.open",
        "title": "Open",
        "category": "Learning Navigator",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "learningNavigator.selectRoot",
        "title": "Select Root Conversation",
        "category": "Learning Navigator"
      },
      {
        "command": "learningNavigator.sync",
        "title": "Sync Official Branches",
        "category": "Learning Navigator"
      },
      {
        "command": "learningNavigator.deleteSubtree",
        "title": "Delete Subtree",
        "category": "Learning Navigator"
      },
      {
        "command": "learningNavigator.undo",
        "title": "Undo",
        "category": "Learning Navigator"
      },
      {
        "command": "learningNavigator.redo",
        "title": "Redo",
        "category": "Learning Navigator"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "learningNavigator.open",
          "group": "navigation@10",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "explorer/title": [
        {
          "command": "learningNavigator.open",
          "group": "navigation@10",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "smoke:app-server": "node scripts/app-server-smoke.cjs",
    "package": "pnpm run check && pnpm run test && pnpm run build && vsce package --no-dependencies --allow-missing-repository --out dist/codex-learning-navigator-0.8.1.vsix"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
